    "agent_id" : "asst_W43zgWnHdSJPzMTps0jqO6cJ",
    "description": "Planning Agent",
    "output_schema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "Background": {
      "type": "string",
      "description": "Describe the company given the basic information. Provide recent performance information where this is known. Introduce some aspect of the problem statement.",
      "minLength": 1800
    },
    "StrategicProblem": {
      "type": "string",
      "description": "State in detail the problem statement and why this is so critical for the company. Refer directly to products, markets, challenges and trends. Be precise and cite your reasoning.",
      "minLength": 3600
    },
    "Analysis": {
      "type": "string",
      "description": "The deep analysis leveraging both the quantitative and qualitative model. Refer to costs, risks, capability strengths and relative strengths of scenarios. Use the provided numerical data to back up the arguments. Refer to the strategic frameworks that have been applied - how do they illustrate the problem and guide towards a solution to it?",
      "minLength": 6000
    },
    "Priorities": {
      "type": "string",
      "description": "Assess whether any of the provided scenarios should represent a strategic priority for the company. This  should primarily draw on the analysis that has been performed around scenarios. What do the scenarios and the utility scores generated say about the priorities of the company, and how does that relate to the original problem statement?. Refer to trends that may override the strategic decision. Be honest about the severity of the specific problem given other challenges and trends - is this a highest priority that the company MUST engage with? What are the risks to the application of this strategy and how could they be mitigated?",
      ",minLength": 3000
    },
    "ActionPlan": {
      "type": "string",
      "description": "Develop a clear action plan of how the company should organise in order to address the problem statement. Cite as many real-world concerns and how they can be navigated.",
      "minLength": 2400
    },
    "ConclusionsAndSummary": {
      "type": "string",
      "description": "Conclusions and summary",
      "minLength": 2400
    }
  },
  "required": ["Background", "StrategicProblem", "Analysis", "Priorities", "ActionPlan", "ConclusionsAndSummary"]
