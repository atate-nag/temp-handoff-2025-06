            "description": "Indicates whether the task is completed."
          },
          "agent instructions": {
            "type": "string",
            "description": "Instructions for the agent."
          }
        },
        "required": [
          "completed",
          "agent instructions",
          "file id"
        ],
        "additionalProperties": false,
        "description": "Schema for validating agent output."
      },
      "prompt": "Check if the agent completed the task. The agent response is in the file : {AGENT_RESPONSE}. If generated, the external output produced by the agent is in file: {AGENT_OUTPUT}. The required schema of the output is schema={AGENT_REQUIREMENTS}. Please perform your 5-stage QM process using this data as input",
      "instructions": "The agent followed your instructions, the new response is in the file : {AGENT_RESPONSE}, and a new output file {AGENT_OUTPUT}. Additionally, the following errors were detected when comparing the agent's output against the provided schema: {AGENT_SCHEMA_ERRORS}. Please repeat all of your 5 QM stages, using the same process on the new data."
    },
    "competitive_analysis_report_agent": {
      "agent_id": "asst_M8PwuNAQx8URyqhDrBHobJtj",
      "description": "Competition Analysis Reporter",
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
          "title": "Competitive Analysis Report",
          "description": "A structured report containing the competitive analysis of a company.",
          "type": "object",
          "properties": {
            "companyName": {
              "type": "string",
              "description": "The name of the company being analyzed."
            },
            "reportDate": {
              "type": "string",
              "format": "date",
              "description": "The date when the report was generated."
            },
            "overview": {
              "type": "string",
              "description": "An executive summary of the competitive landscape.",
              "minWords": 300
            },
            "keyCompetitors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the competitor."
                  },
                  "description": {
                    "type": "string",
                    "description": "A brief description of the competitor and their business focus.",
                    "minWords": 300
                  },
                  "marketPosition": {
                    "type": "string",
                    "description": "Description of the competitor's position in the market.",
                    "minWords": 500
                  },
                  "strengths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minWords": 100
                    },
                    "description": "List of the competitor's key strengths."
                  },
                  "weaknesses": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minWords": 100
                    },
                    "description": "List of the competitor's notable weaknesses."
                  },
                  "opportunities": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minWords": 200
                    },
                    "description": "Opportunities in the market that the competitor could exploit."
                  },
                  "threats": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minWords": 200
                    },
                    "description": "Potential threats in the market that could impact the competitor."
                  }
                },
                "required": ["name", "description", "marketPosition"]
              },
              "minItems": 1,
              "description": "A list of key competitors and their analysis."
            },
            "marketTrends": {
              "type": "string",
              "description": "Analysis of the prevailing market trends affecting the industry.",
              "minWords": 300
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "string",
                "minWords": 500
              },
              "description": "Strategic recommendations based on the competitive analysis."
            }
          },
          "required": ["companyName", "reportDate", "overview", "keyCompetitors", "marketTrends", "recommendations"]
        },
      "prompt": "Write the Competitive Analysis Report based on the compamy information and competitor information contained in the input files {INPUT_FILES}"
    },
