            "type": "string",
            "description": "Instructions for the agent."
          },
          "file id": {
            "type": "string",
            "description": "The identifier for the file."
          }
        },
        "required": [
          "completed",
          "agent instructions",
          "file id"
        ],
        "additionalProperties": false,
        "description": "Schema for validating agent output."
      },
      "prompt": "Check if the agent completed the task. The agent response and output are in the file : {RESPONSE_FILE}. If generated, the external output produced by the agent is in file: {AGENT_OUTPUT} and the output_requirements_schema={AGENT_REQUIREMENTS}"
    },
