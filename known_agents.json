{
  "known_agents": {

    "insight_agent": {
      "id": "asst_iYvVBX1aaxu3KBgSEvIAZFEb",
      "description": "Structured Extraction Agent",
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "insight": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "sourceDocument": {
                  "type": "string"
                },
                "extractionDate": {
                  "type": "string",
                  "format": "date"
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "relevanceScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 99
                }
              },
              "required": [
                "description",
                "sourceDocument",
                "extractionDate",
                "categories",
                "relevanceScore"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "insight"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
    "condense_agent": {
      "id": "asst_AzJOCJFl1D8BKF4oNrge9XF8",
      "description": "Condensing Assistant for Json",
      "output_schema": {},
      "prompt" : "Condense the file(s): {INPUT_FILES}"
    },

    "recommender_agent": {
      "id": "asst_Fh2bYH5IaS0qJKrMlNO3DZLJ",
      "description": "Recommender Agent",
      "output_schema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Insights\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"id\": { \"type\": \"integer\" },\n      \"description\": { \"type\": \"string\" },\n      \"relevanceScore\": { \"type\": \"number\" },\n      \"recommendation\": {\n        \"type\": \"string\",\n        \"enum\": [\"prune\", \"retain\"]\n      },\n      \"justification\": { \"type\": \"string\" }\n    },\n    \"required\": [\"id\", \"description\", \"relevanceScore\", \"recommendation\", \"justification\"]\n  }\n}\n",
      "prompt" : "Make the recommendations based on the file(s): {INPUT_FILES}"
    },
    "competition_agent": {
      "id": "asst_uphvlsvGIbtXQAx89cFShovV",
      "description": "Competition Description",
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "competitor": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description of competitive threat": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "Services": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "Leadership": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "role": {
                            "type": "string"
                          },
                          "joined": {
                            "type": "string",
                            "pattern": "^(\\d{4})$"
                          },
                          "experience": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "role",
                          "joined"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "Products": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "name": {
                      "type": "string"
                    },
                    "HQ": {
                      "type": "string"
                    },
                    "size": {
                      "type": "string",
                      "pattern": "^[0-9,]+$"
                    }
                  },
                  "required": [
                    "Services",
                    "Leadership",
                    "Products",
                    "name",
                    "HQ",
                    "size"
                  ],
                  "additionalProperties": false
                },
                "competes through": {
                  "type": "string"
                },
                "competes with": {
                  "type": "string"
                },
                "strength of competitive threat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 99
                }
              },
              "minItems" : 9,
              "required": [
                "name",
                "description of competitive threat",
                "data",
                "competes through",
                "competes with",
                "strength of competitive threat"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "competitor"
          ]
        }
      },
      "prompt": "Define the competitive environment based on the file(s): {INPUT_FILES}"
    },
    "capabilities_agent": {
      "id": "asst_NoLfJg1BUS4yNuZhurDAedXO",
      "description": "Capabilities Agent",
      "prompt": "Generate the capabilities relevant to the company and insights in the file(s): {INPUT_FILES}",
      "output_schema" : {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "capability": { "type": "string" },
            "value potential": { "type": "integer", "minimum": 1, "maximum": 99 },
            "scarcity": { "type": "integer", "minimum": 1, "maximum": 99 },
            "non-replicability": { "type": "integer", "minimum": 1, "maximum": 99 },
            "irreplaceability": { "type": "integer", "minimum": 1, "maximum": 99 },
            "evidenced by": {
              "type": "array",
              "items": { "type": "string" }
            },
            "confidence": { "type": "integer", "minimum": 1, "maximum": 99 }
          },
          "required": [
            "capability",
            "value potential",
            "scarcity",
            "non-replicability",
            "irreplaceability",
            "evidenced by",
            "confidence"
          ]
        }
      }
    },

    "qm_agent": {
      "id": "asst_49YnOtEIzaLI8scAJsiqLw8G",
