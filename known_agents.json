{
  "known_agents": {
    "competition_agent": {
      "id": "asst_uphvlsvGIbtXQAx89cFShovV",
      "description": "Competition Description",
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "competitor": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "description of competitive threat": { "type": "string" },
                "data": {
                  "type": "object",
                  "properties": {
                    "Services": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string" }
                    },
                    "Leadership": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "role": { "type": "string" },
                          "joined": {
                            "type": "string",
                            "pattern": "^(\\d{4})$"
                          },
                          "experience": { "type": "string" }
                        },
                        "required": ["name", "role", "joined"],
                        "additionalProperties": false
                      }
                    },
                    "Products": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "string" }
                    },
                    "name": { "type": "string" },
                    "HQ": { "type": "string" },
                    "size": {
                      "type": "string",
                      "pattern": "^[0-9,]+$"
                    }
                  },
                  "required": ["Services", "Leadership", "Products", "name", "HQ", "size"],
                  "additionalProperties": false
                },
                "competes through": { "type": "string" },
                "competes with": { "type": "string" },
                "strength of competitive threat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 99
                }
              },
              "required": [
                "name",
                "description of competitive threat",
                "data",
                "competes through",
                "competes with",
                "strength of competitive threat"
              ],
              "additionalProperties": false
            }
          },
          "required": ["competitor"]
        }
      }
    },
    "insight_agent": {
      "id": "asst_iYvVBX1aaxu3KBgSEvIAZFEb",
      "description": "Structured Extraction Agent",
      "output_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "insight": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "sourceDocument": {
                  "type": "string"
                },
                "extractionDate": {
                  "type": "string",
                  "format": "date"
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "relevanceScore": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 99
                }
              },
              "required": ["description", "sourceDocument", "extractionDate", "categories", "relevanceScore"],
              "additionalProperties": false
            }
          },
          "required": ["insight"],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
